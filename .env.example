# PayPal Sandbox API Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: Shared Sandbox Test Buyer credentials for Hackathon Judges
NEXT_PUBLIC_PAYPAL_SANDBOX_BUYER_EMAIL=your_sandbox_buyer_email@personal.example.com
NEXT_PUBLIC_PAYPAL_SANDBOX_BUYER_PASSWORD=your_sandbox_buyer_password

# Optional: OpenAI API Key for live multimodal agent negotiation
# PayAgent includes a built-in realistic Agentic Commerce reasoning engine if no key is supplied!
OPENAI_API_KEY=your_openai_api_key_optional
